<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenCvNativePackage Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(OS)' != 'Windows_NT'">OpenCvSharp4.official.runtime.linux-x64</OpenCvNativePackage>
    <OpenCvNativePackage Condition="'$(OpenCvNativePackage)' == ''">OpenCvSharp4.runtime.win</OpenCvNativePackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
    <PackageReference Include="$(OpenCvNativePackage)" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="App_Data\**" /><None Remove="App_Data\**" />
    <Content Include="ModelsData\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ModelsData\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- OpenCvSharp's bundled analyzer requires a newer compiler than the .NET 8 SDK. -->
  <Target Name="RemoveIncompatibleOpenCvAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup><Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'OpenCvSharp.Analyzers'" /></ItemGroup>
  </Target>
</Project>



